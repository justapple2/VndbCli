<Project>
  <PropertyGroup>
    <VnPrivateRoot Condition="'$(VN_PRIVATE_ROOT)' == ''">$(MSBuildThisFileDirectory)../VndbCli.private/</VnPrivateRoot>
    <VnPrivateRoot Condition="'$(VN_PRIVATE_ROOT)' != ''">$(VN_PRIVATE_ROOT)/</VnPrivateRoot>
    <BaseOutputPath>$(VnPrivateRoot)build/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(VnPrivateRoot)build/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.5.0</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>VNDB Local contributors</Authors>
    <Copyright>Copyright (c) 2026 VNDB Local contributors</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(BaseIntermediateOutputPath)$(RuntimeIdentifier).packages.lock.json</NuGetLockFilePath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
