<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Vndb.Desktop.ViewModels" xmlns:c="using:Vndb.Desktop.Controls" xmlns:views="using:Vndb.Desktop.Views" xmlns:core="clr-namespace:Vndb.Core;assembly=Vndb.Core"
             x:Class="Vndb.Desktop.Views.ShelfView" x:DataType="vm:MainViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="BookCardTemplate" x:DataType="vm:BookViewModel">
      <Grid ContextRequested="OnBookContextRequested" DoubleTapped="OnBookDoubleTapped">
        <Button Classes="card" Classes.chosen="{Binding Selected}" Classes.bilingual="{Binding HasJapaneseSubtitle}" Classes.organized="{Binding HasPersonalLabels}" Click="OnCardClick" AutomationProperties.Name="{Binding Title}">
          <Grid RowDefinitions="216,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
            <Grid><c:CoverView Metadata="{Binding Metadata}" Background="{DynamicResource CoverBrush}" /><Border Classes="badge" IsVisible="{Binding IsLocal}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"><TextBlock Text="{Binding LocalLabel}" /></Border></Grid>
            <StackPanel Grid.Row="1" Classes="compact"><TextBlock Text="{Binding Title}" Classes="book-title" ToolTip.Tip="{Binding Title}" /><TextBlock Text="{Binding JapaneseSubtitle}" IsVisible="{Binding HasJapaneseSubtitle}" Classes="caption ellipsis" ToolTip.Tip="{Binding JapaneseSubtitle}" /></StackPanel>
            <TextBlock Grid.Row="2" Text="{Binding Company}" Classes="caption ellipsis" ToolTip.Tip="{Binding Company}" />
            <TextBlock Grid.Row="3" Text="{Binding PlaySummary}" Classes="caption ellipsis" ToolTip.Tip="{Binding PlayAssociationNotice}" />
            <TextBlock Grid.Row="4" Text="{Binding ResourceLabel}" Classes="caption ellipsis" ToolTip.Tip="{Binding LocalObservation}" />
            <TextBlock Grid.Row="5" Text="{Binding LaunchLabel}" Classes="caption ellipsis" ToolTip.Tip="{Binding ReportedPresence}" />
            <StackPanel Grid.Row="6" Classes="compact"><TextBlock Text="{Binding ReportedPresence}" Classes="caption ellipsis" /><TextBlock Text="{Binding PersonalLabels}" IsVisible="{Binding HasPersonalLabels}" Classes="caption ellipsis" /></StackPanel>
          </Grid>
        </Button>
        <Button Classes="book-more icon" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Click="OnMoreClick" AutomationProperties.Name="作品更多操作" ToolTip.Tip="更多操作（也可右键或按菜单键）"><c:AppIcon Kind="More" /></Button>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="BookListTemplate" x:DataType="vm:BookViewModel">
      <Grid Classes="book-row" ColumnDefinitions="72,*,36" ContextRequested="OnBookContextRequested" DoubleTapped="OnBookDoubleTapped">
        <c:CoverView Metadata="{Binding Metadata}" Background="{DynamicResource CoverBrush}" />
        <StackPanel Grid.Column="1" Classes="compact" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Classes="strong ellipsis" ToolTip.Tip="{Binding Title}" /><TextBlock Text="{Binding JapaneseSubtitle}" IsVisible="{Binding HasJapaneseSubtitle}" Classes="caption ellipsis" ToolTip.Tip="{Binding JapaneseSubtitle}" /><TextBlock Text="{Binding Company}" Classes="caption ellipsis" ToolTip.Tip="{Binding Company}" /><TextBlock Text="{Binding PlaySummary}" Classes="caption" ToolTip.Tip="{Binding PlayAssociationNotice}" /><TextBlock Text="{Binding ResourceLabel}" Classes="caption wrap" ToolTip.Tip="{Binding LocalObservation}" /><TextBlock Text="{Binding LaunchLabel}" Classes="caption ellipsis" ToolTip.Tip="{Binding LaunchLabel}" /><TextBlock Text="{Binding ReportedPresence}" Classes="caption" /><TextBlock Text="{Binding PersonalLabels}" IsVisible="{Binding HasPersonalLabels}" Classes="caption ellipsis" /><TextBlock Text="{Binding LastOpenedLabel}" Classes="caption" /></StackPanel>
        <Button Grid.Column="2" Classes="book-more icon" VerticalAlignment="Top" Click="OnMoreClick" AutomationProperties.Name="作品更多操作" ToolTip.Tip="更多操作"><c:AppIcon Kind="More" /></Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
    <Grid x:Name="ShelfToolbar" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Classes="compact"><TextBlock Text="{Binding Shelf.PageLabel}" Classes="strong" /><TextBlock Text="{Binding Shelf.Source}" Classes="caption wrap" /></StackPanel>
      <StackPanel Grid.Column="1" Classes="inline">
        <Button Classes="quiet icon" Command="{Binding Shelf.OpenDetailsCommand}" AutomationProperties.Name="查看所选作品详情" ToolTip.Tip="查看详情（Enter／双击）"><c:AppIcon Kind="Book" /></Button>
        <Button x:Name="ShelfViewToggle" Classes="icon" Command="{Binding Shelf.ToggleViewCommand}" ToolTip.Tip="切换卡片／列表" AutomationProperties.Name="切换卡片列表"><c:AppIcon Kind="Grid" /></Button>
        <Button Classes="icon" Command="{Binding Shelf.PreviousCommand}" ToolTip.Tip="上一页" AutomationProperties.Name="上一页"><c:AppIcon Kind="Left" /></Button>
        <Button Classes="icon" Command="{Binding Shelf.NextCommand}" ToolTip.Tip="下一页" AutomationProperties.Name="下一页"><c:AppIcon Kind="Right" /></Button>
      </StackPanel>
    </Grid>
    <StackPanel x:Name="ShelfFilters" Grid.Row="1" Classes="compact">
      <WrapPanel Classes="filters"><TextBlock Text="快捷视图" Classes="caption" VerticalAlignment="Center" /><ComboBox Classes="company-filter" ItemsSource="{Binding Shelf.QuickViews}" SelectedItem="{Binding Shelf.QuickView}" AutomationProperties.Name="书架快捷视图" /><TextBlock Text="本机资源与Web上报分开；未记录不等于未玩" Classes="caption" VerticalAlignment="Center" /></WrapPanel>
      <Expander Classes="shelf-filters" Header="{Binding Shelf.FilterHeading}" IsExpanded="{Binding Shelf.FiltersExpanded}" HorizontalContentAlignment="Stretch">
        <WrapPanel Classes="filters">
          <TextBox x:Name="ShelfFilter" Classes="shelf-filter" Text="{Binding Shelf.Filter}" PlaceholderText="{Binding Shelf.FilterPlaceholder}" AutomationProperties.Name="筛选当前书架结果" />
          <ComboBox Classes="company-filter" ItemsSource="{Binding Shelf.CompanyFilters}" SelectedItem="{Binding Shelf.CompanyFilter}" AutomationProperties.Name="会社筛选" />
          <ComboBox Classes="short-filter" ItemsSource="{Binding Shelf.ShelfStates}" SelectedItem="{Binding Shelf.ShelfState}" AutomationProperties.Name="游玩状态筛选" />
          <ComboBox Classes="short-filter" ItemsSource="{Binding Shelf.ResourceFilters}" SelectedItem="{Binding Shelf.ResourceFilter}" AutomationProperties.Name="本机资源筛选" />
          <ComboBox Classes="short-filter" ItemsSource="{Binding Shelf.ShelfSorts}" SelectedItem="{Binding Shelf.ShelfSort}" AutomationProperties.Name="书架排序" />
          <CheckBox Content="★ 仅收藏" IsChecked="{Binding Shelf.FavoritesOnly}" />
          <ComboBox Classes="company-filter" ItemsSource="{Binding Shelf.LabelFilters}" SelectedItem="{Binding Shelf.SelectedLabelFilter}" AutomationProperties.Name="个人集合标签筛选"><ComboBox.ItemTemplate><DataTemplate x:DataType="core:PersonalLabel"><TextBlock Text="{Binding ., Converter={StaticResource LocalChoiceLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <CheckBox Content="降序" IsChecked="{Binding Shelf.SortDescending}" /><CheckBox Content="本机有副本" IsChecked="{Binding Shelf.LocalOnly}" />
          <Button Classes="quiet icon" Command="{Binding Shelf.ResetFiltersCommand}" ToolTip.Tip="清除当前视图筛选" AutomationProperties.Name="重置筛选"><c:AppIcon Kind="Filter" /></Button>
          <Button Classes="quiet icon" Command="{Binding Shelf.SavePreferencesCommand}" IsVisible="{Binding Shelf.IsHome}" ToolTip.Tip="记住书架偏好，仅保存于本机" AutomationProperties.Name="记住书架偏好"><c:AppIcon Kind="Save" /></Button>
        </WrapPanel>
      </Expander>
      <TextBlock Text="{Binding Shelf.FilterSummary}" IsVisible="{Binding Shelf.HasFilters}" Classes="caption wrap" AutomationProperties.Name="生效的书架筛选" />
      <ItemsControl ItemsSource="{Binding Shelf.Conditions}" IsVisible="{Binding Shelf.HasFilters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ShelfFilterChip"><Button Classes="quiet" Command="{Binding $parent[views:ShelfView].((vm:MainViewModel)DataContext).Shelf.RemoveFilterCommand}" CommandParameter="{Binding Key}" ToolTip.Tip="移除此条件"><StackPanel Classes="inline"><TextBlock Text="{Binding Label}" /><TextBlock Text="×" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <Grid Grid.Row="2" x:Name="ContentArea">
      <Grid ColumnDefinitions="*,0" ColumnSpacing="0" x:Name="ShelfColumns">
        <Grid x:Name="BookArea">
          <ListBox Classes="card-rows" ItemsSource="{Binding Shelf.Rows}" IsVisible="{Binding !Shelf.ListMode}" x:Name="CardRows" Focusable="False" AutomationProperties.Name="虚拟化卡片书架">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:BookRow"><ItemsControl ItemsSource="{Binding Books}" ItemTemplate="{StaticResource BookCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <ListBox Classes="book-list" ItemsSource="{Binding Shelf.Books}" SelectedItem="{Binding Shelf.SelectedBook}" IsVisible="{Binding Shelf.ListMode}" ItemTemplate="{StaticResource BookListTemplate}" x:Name="BookList" AutomationProperties.Name="封面列表书架"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
          <TextBlock Text="没有符合筛选的作品。可清除筛选，或进入查询作品。" Classes="caption wrap" IsVisible="{Binding Shelf.ShelfEmpty}" Margin="12" IsHitTestVisible="False" />
        </Grid>
      </Grid>
    </Grid>
      <Border Grid.RowSpan="3" x:Name="DetailsBackdrop" Background="{DynamicResource OverlayBrush}" IsVisible="False" PointerPressed="OnBackdropPressed" />
      <Border Grid.Row="2" x:Name="DetailPanel" Classes="panel shelf-detail" IsVisible="False" HorizontalAlignment="Right" Width="{StaticResource ShelfDetailWidth}" KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="作品详情" Classes="section-title" /><Button Grid.Column="1" x:Name="CloseDetails" Classes="quiet icon" Command="{Binding Shelf.CloseDetailsCommand}" AutomationProperties.Name="关闭作品详情" ToolTip.Tip="关闭详情 Esc"><c:AppIcon Kind="Close" /></Button></Grid>
          <ScrollViewer Grid.Row="1"><StackPanel Classes="form">
            <WrapPanel Classes="filters"><Button Content="返回原详情" Command="{Binding BackRelatedCommand}" IsVisible="{Binding CanBackRelated}" IsEnabled="{Binding !Busy}" /><Button Content="回填关联ID到查询" Command="{Binding PrepareRelatedQueryCommand}" IsVisible="{Binding HasMissingRelated}" /></WrapPanel>
            <TextBlock Text="{Binding RelatedNotice}" Classes="caption wrap" AutomationProperties.LiveSetting="Polite" />
            <c:CoverView x:Name="DetailsCover" Metadata="{Binding BookDetails.CoverMetadata}" Height="{StaticResource ShelfDetailCoverHeight}" Background="{DynamicResource CoverBrush}" />
            <ContentControl Content="{Binding BookDetails.Book}" ContentTemplate="{StaticResource BookDetailHeadingTemplate}" />
            <TextBlock Text="公共资料与来源" Classes="strong" />
            <ItemsControl ItemsSource="{Binding BookDetails.Metadata}" ItemTemplate="{StaticResource DetailFieldTemplate}" />
            <ContentControl Content="{Binding BookDetails.Book}" ContentTemplate="{StaticResource BookDescriptionTemplate}" />
            <ContentControl Content="{Binding BookDetails.ReleaseBrowser}" />
            <Expander Header="关联作品 · 只读本库" IsExpanded="True" HorizontalContentAlignment="Stretch"><StackPanel Classes="compact">
              <TextBlock Text="{Binding BookDetails.Relations.Summary}" Classes="caption wrap" />
              <ItemsControl ItemsSource="{Binding BookDetails.Relations.Rows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RelatedNovelRow"><StackPanel Classes="compact detail-field">
                <TextBlock Text="{Binding Label}" Classes="caption wrap" /><Button Content="{Binding Title}" Command="{Binding OpenCommand}" CommandParameter="{Binding}" />
              </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Button Content="再显示20条关联" Command="{Binding BookDetails.Relations.MoreCommand}" IsVisible="{Binding BookDetails.Relations.HasMore}" />
            </StackPanel></Expander>
            <StackPanel Classes="form" IsVisible="{Binding BookDetails.IsPersonal}">
            <TextBlock Text="个人覆盖与书架备注" Classes="strong" /><ItemsControl ItemsSource="{Binding BookDetails.PersonalFields}" ItemTemplate="{StaticResource DetailFieldTemplate}" />
            <TextBlock Text="游玩经历" Classes="strong" />
            <ContentControl Content="{Binding BookDetails.Book}" ContentTemplate="{StaticResource BookPlaySummaryTemplate}" />
            <Button Classes="quiet" Command="{Binding DetailCommand}" Content="读取此条目完整记录" />
            <ItemsControl ItemsSource="{Binding BookDetails.Plays}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PlayDetailRow">
                <Border Classes="detail-record"><StackPanel Classes="compact">
                  <TextBlock Text="{Binding Heading}" Classes="strong wrap" /><TextBlock Text="{Binding Identity}" Classes="caption wrap" />
                  <TextBlock Text="{Binding Time}" Classes="caption wrap" /><TextBlock Text="{Binding Score}" Classes="caption" />
                  <SelectableTextBlock Text="{Binding Review}" Classes="wrap" />
                  <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource DetailFieldTemplate}" />
                  <Button Content="编辑这次记录" Command="{Binding $parent[views:ShelfView].((vm:MainViewModel)DataContext).EditPlayRecordCommand}" CommandParameter="{Binding}" />
                </StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Command="{Binding EditBookPlayCommand}" CommandParameter="{Binding SelectedBook}"><StackPanel Classes="inline"><c:AppIcon Kind="Clock" /><TextBlock Text="选择／新建游玩记录" /></StackPanel></Button>
            </StackPanel>
            <StackPanel Classes="form" IsVisible="{Binding IsPrimaryDetail}">
            <Expander Header="个人收藏、集合与标签" HorizontalContentAlignment="Stretch"><views:PersonalOrganizationView DataContext="{Binding PersonalOrganization}" /></Expander>
            <Expander Header="本机资源档案" HorizontalContentAlignment="Stretch"><views:ResourceArchiveView DataContext="{Binding ResourceArchive}" /></Expander>
            <TextBlock Text="仅本机 · 安装与启动" Classes="strong" />
            <TextBlock Text="{Binding BookDetails.LocalStatus}" Classes="caption wrap" AutomationProperties.Name="本机启动就绪说明" />
            <ItemsControl ItemsSource="{Binding BookDetails.LocalFields}" ItemTemplate="{StaticResource DetailFieldTemplate}" />
            <ComboBox ItemsSource="{Binding LaunchMethods}" SelectedItem="{Binding LaunchMode}" IsVisible="{Binding BookDetails.LaunchConfigured}" AutomationProperties.Name="书架启动方式" />
            <Button Classes="primary" Command="{Binding QuickLaunchCommand}" Content="按配置启动" IsVisible="{Binding BookDetails.LaunchConfigured}" />
            <Button Content="配置／选择启动入口" Command="{Binding ConfigureBookCommand}" CommandParameter="{Binding SelectedBook}" IsVisible="{Binding BookDetails.HasInstallation}" />
            <Button Content="登记／重新核对本机安装" Command="{Binding RegisterBookCommand}" CommandParameter="{Binding SelectedBook}" />
            <Button Content="登记本地安装包" Command="{Binding RegisterPackageBookCommand}" CommandParameter="{Binding SelectedBook}" />
            <Button Content="启动诊断与修复…" Command="{Binding RegistryBookCommand}" CommandParameter="{Binding SelectedBook}" IsVisible="{Binding BookDetails.HasInstallation}" />
            <Expander Header="本机安装与组件" HorizontalContentAlignment="Stretch"><StackPanel Classes="compact"><ComboBox ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation}" ItemTemplate="{StaticResource InstallationTemplate}" AutomationProperties.Name="完整安装" /><ItemsControl ItemsSource="{Binding SelectedComponents}" ItemTemplate="{StaticResource ComponentTemplate}" /></StackPanel></Expander>
            </StackPanel>
            <Button Content="读取所选作品资料与经历" Command="{Binding DetailCommand}" IsVisible="{Binding BookDetails.DetailsPending}" />
          </StackPanel></ScrollViewer>
        </Grid>
      </Border>
  </Grid>
</UserControl>
