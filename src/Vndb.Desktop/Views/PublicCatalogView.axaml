<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Vndb.Desktop.ViewModels" xmlns:c="using:Vndb.Desktop.Controls"
             xmlns:contracts="using:Vndb.Contracts" x:Class="Vndb.Desktop.Views.PublicCatalogView" x:DataType="vm:PublicCatalogViewModel" SizeChanged="OnResize">
  <UserControl.KeyBindings><KeyBinding Gesture="Ctrl+Enter" Command="{Binding BrowseCommand}" /></UserControl.KeyBindings>
  <UserControl.Resources>
    <DataTemplate x:Key="CatalogChoice" x:DataType="vm:CatalogChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
    <DataTemplate x:Key="CatalogText" x:DataType="vm:CatalogBookViewModel">
      <StackPanel Classes="compact"><TextBlock Text="{Binding Title}" Classes="strong ellipsis" ToolTip.Tip="{Binding Title}" /><TextBlock Text="{Binding JapaneseSubtitle}" IsVisible="{Binding HasJapaneseSubtitle}" Classes="caption ellipsis" ToolTip.Tip="{Binding JapaneseSubtitle}" /><TextBlock Text="{Binding Company}" Classes="caption ellipsis" ToolTip.Tip="{Binding Company}" /><TextBlock Text="{Binding Personal}" Classes="caption wrap" /><TextBlock Text="{Binding Presence}" Classes="caption wrap" /><TextBlock Text="{Binding Source}" Classes="caption ellipsis" ToolTip.Tip="{Binding Source}" /></StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="CatalogCard" x:DataType="vm:CatalogBookViewModel">
      <Button Classes="card catalog-card" Classes.bilingual="{Binding HasJapaneseSubtitle}" Classes.chosen="{Binding IsSelected}" Click="OnSelect" AutomationProperties.Name="{Binding Title}"><Grid RowDefinitions="180,Auto" RowSpacing="8"><c:CoverView Metadata="{Binding Metadata}" Background="{DynamicResource CoverBrush}" /><ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource CatalogText}" /></Grid></Button>
    </DataTemplate>
    <DataTemplate x:Key="CatalogList" x:DataType="vm:CatalogBookViewModel">
      <Grid ColumnDefinitions="72,*" ColumnSpacing="12"><c:CoverView Metadata="{Binding Metadata}" Background="{DynamicResource CoverBrush}" /><ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource CatalogText}" /></Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
    <ScrollViewer MaxHeight="300"><Expander Header="全库搜索与发行版本筛选" IsExpanded="{Binding FiltersExpanded}" HorizontalContentAlignment="Stretch">
      <StackPanel Classes="compact">
        <WrapPanel Classes="filters"><TextBox Classes="shelf-filter" Text="{Binding ProducerQuery}" PlaceholderText="按会社名称或ID查找Web已收录选项" AutomationProperties.Name="公共目录会社名称" /><Button Content="查找会社" Command="{Binding FindProducersCommand}" />
          <ComboBox Classes="company-filter" ItemsSource="{Binding Producers}" SelectedItem="{Binding Producer}" AutomationProperties.Name="公共目录会社名称选择"><ComboBox.ItemTemplate><DataTemplate x:DataType="contracts:CatalogProducerChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        </WrapPanel>
        <ContentControl Content="{Binding History}" />
        <WrapPanel Classes="filters">
          <StackPanel Classes="compact"><TextBlock Text="关键词" Classes="caption" /><TextBox Classes="shelf-filter" Text="{Binding Query}" PlaceholderText="标题、原文、别名或v编号" AutomationProperties.Name="公共目录关键词" /></StackPanel>
          <StackPanel Classes="compact"><TextBlock Text="会社编号" Classes="caption" /><TextBox Classes="short-filter" Text="{Binding ProducerId}" PlaceholderText="会社ID（如p1）" AutomationProperties.Name="公共目录会社ID" /></StackPanel>
          <StackPanel Classes="compact"><TextBlock Text="发行语言" Classes="caption" /><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" ItemTemplate="{StaticResource CatalogChoice}" AutomationProperties.Name="发行语言" /></StackPanel>
          <StackPanel Classes="compact"><TextBlock Text="发行类型" Classes="caption" /><ComboBox ItemsSource="{Binding ReleaseTypes}" SelectedItem="{Binding ReleaseType}" ItemTemplate="{StaticResource CatalogChoice}" AutomationProperties.Name="发行类型" /></StackPanel>
          <StackPanel Classes="compact"><TextBlock Text="发行平台" Classes="caption" /><TextBox Classes="short-filter" Text="{Binding Platform}" PlaceholderText="平台代码，如win" AutomationProperties.Name="发行平台" /></StackPanel>
          <CheckBox Content="包含机翻" IsChecked="{Binding IncludeMtl}" />
        </WrapPanel>
        <WrapPanel Classes="filters"><ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" ItemTemplate="{StaticResource CatalogChoice}" AutomationProperties.Name="目录全局排序" /></WrapPanel>
      </StackPanel>
    </Expander></ScrollViewer>
    <StackPanel Grid.Row="1" Classes="compact"><TextBlock Text="{Binding Summary}" Classes="strong wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="{Binding FilterStatus}" Classes="caption wrap" AutomationProperties.LiveSetting="Polite" /><ProgressBar Classes="catalog-progress" IsVisible="{Binding IsLoading}" /><TextBlock Text="{Binding Coverage}" Classes="caption wrap" /></StackPanel>
    <WrapPanel Grid.Row="2" Classes="filters"><Button Content="应用筛选并浏览" Classes="primary" Command="{Binding BrowseCommand}" ToolTip.Tip="Ctrl+Enter 应用条件；翻页沿用上次成功条件" /><Button Content="重置筛选" Command="{Binding ResetFiltersCommand}" /><Button Content="上一页" Command="{Binding PreviousCommand}" /><Button Content="下一页" Command="{Binding NextCommand}" /><CheckBox Content="仅本机历史页JSON" IsChecked="{Binding CacheOnly}" /><CheckBox Content="列表视图" IsChecked="{Binding ListMode}" /><Button Content="读取所选作品详情" Command="{Binding DetailsCommand}" ToolTip.Tip="{Binding SelectedTitle}" /></WrapPanel>
    <Grid Grid.Row="3">
      <StackPanel IsVisible="{Binding !HasLoaded}" Classes="compact"><TextBlock Text="浏览你已保存的作品资料" Classes="strong" /><TextBlock Text="展开筛选后点击浏览，或按 Ctrl+Enter。选择卡片后可读取详情。" Classes="caption wrap" /></StackPanel>
      <StackPanel IsVisible="{Binding IsEmpty}" Classes="compact"><TextBlock Text="没有匹配的作品" Classes="strong" /><TextBlock Text="尝试重置筛选并重新浏览；此页面不会自动联网补全。" Classes="caption wrap" /></StackPanel>
      <ListBox ItemsSource="{Binding Rows}" Classes="card-rows" IsVisible="{Binding !ListMode}" AutomationProperties.Name="公共目录卡片">
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:CatalogRow"><ItemsControl ItemsSource="{Binding Books}" ItemTemplate="{StaticResource CatalogCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ListBox ItemsSource="{Binding Books}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource CatalogList}" Classes="book-list" IsVisible="{Binding ListMode}" AutomationProperties.Name="公共目录封面列表"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
    </Grid>
  </Grid>
</UserControl>
