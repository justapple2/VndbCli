<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Vndb.Desktop.Controls">
  <Styles.Resources>
    <ControlTheme x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="44" /><Setter Property="Height" Value="40" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template"><ControlTemplate><Border x:Name="ChromeBackground" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter>
      <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
      <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Style>
      <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.7" /></Style>
      <Style Selector="^:focus-visible /template/ Border#ChromeBackground"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="NavigationItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="14,12" /><Setter Property="Margin" Value="0,0,0,4" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Template"><ControlTemplate><Border x:Name="NavBackground" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Border></ControlTemplate></Setter>
      <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource CoverBrush}" /></Style>
      <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
      <Style Selector="^:focus-visible /template/ Border#NavBackground"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource CanvasBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontSize" Value="{StaticResource FontBody}" /><Setter Property="FontFamily" Value="Microsoft YaHei UI, Yu Gothic UI, sans-serif" /></Style>
  <Style Selector="c|AppIcon"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /></Style>
  <Style Selector="c|AppIcon.small"><Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /></Style>
  <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="{StaticResource FontCaption}" /></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="{StaticResource FontHeading}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.section-title"><Setter Property="FontSize" Value="{StaticResource FontSection}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.strong"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.wrap, SelectableTextBlock.wrap"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="TextBlock.ellipsis"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
  <Style Selector="StackPanel.form"><Setter Property="Spacing" Value="12" /></Style>
  <Style Selector="StackPanel.compact"><Setter Property="Spacing" Value="6" /></Style>
  <Style Selector="StackPanel.inline"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="8" /></Style>
  <Style Selector="StackPanel.inline TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="14,8" /><Setter Property="CornerRadius" Value="9" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" /></Style>
  <Style Selector="Button.icon"><Setter Property="Width" Value="36" /><Setter Property="Padding" Value="8" /></Style>
  <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Button.book-more"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" /></Style>
  <Style Selector="Button.book-more:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
  <Style Selector="TextBox, ComboBox, NumericUpDown"><Setter Property="BorderBrush" Value="{DynamicResource InputEdgeBrush}" /></Style>
  <Style Selector="TextBox.shelf-filter"><Setter Property="Width" Value="250" /></Style>
  <Style Selector="Expander.shelf-filters"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" /></Style>
  <Style Selector="ListBox.card-rows ListBoxItem"><Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="ListBox.card-rows ListBoxItem:selected"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.close:pointerover /template/ Border#ChromeBackground"><Setter Property="Background" Value="{DynamicResource DangerFillBrush}" /></Style>
  <Style Selector="Button.close:pointerover"><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="TextBox, ComboBox, NumericUpDown"><Setter Property="MinHeight" Value="36" /></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="8" /></Style>
  <Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" /><Setter Property="Padding" Value="{StaticResource PanelPadding}" /></Style>
  <Style Selector="Border.badge"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="6,3" /></Style>
  <Style Selector="Border.badge TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /><Setter Property="FontSize" Value="{StaticResource FontCaption}" /></Style>
  <Style Selector="Button.card"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" /><Setter Property="Padding" Value="10" /><Setter Property="CornerRadius" Value="13" /><Setter Property="Height" Value="{StaticResource ShelfCardHeight}" /><Setter Property="Margin" Value="5" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /><Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" /><BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" /></Transitions></Setter>
  </Style>
  <Style Selector="Button.card:pointerover"><Setter Property="RenderTransform" Value="translateY(-2px)" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.card:pressed"><Setter Property="RenderTransform" Value="scale(0.985)" /></Style>
  <Style Selector="Button.card.chosen"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
  <Style Selector="TextBlock.book-title"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="MaxLines" Value="2" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
  <Style Selector="Grid.book-row"><Setter Property="ColumnSpacing" Value="14" /><Setter Property="Margin" Value="8" /><Setter Property="MinHeight" Value="{StaticResource ShelfListMinimumHeight}" /></Style>
  <Style Selector="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="4" /></Style>
  <Style Selector="ListBox.book-list ListBoxItem:selected TextBlock.caption"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="Grid.page-content"><Setter Property="Margin" Value="{StaticResource PagePadding}" /></Style>
  <Style Selector="Border.sidebar"><Setter Property="Background" Value="{DynamicResource SidebarBrush}" /><Setter Property="Padding" Value="12,20,12,16" /><Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" /><Setter Property="BorderThickness" Value="0,0,1,0" /></Style>
  <Style Selector="StackPanel.nav-content"><Setter Property="Spacing" Value="12" /></Style>
  <Style Selector="Window.compact TextBlock.nav-label, Window.compact TextBlock.nav-caption"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Window.compact Grid.page-content"><Setter Property="Margin" Value="16,16,16,12" /></Style>
  <Style Selector="Window.no-motion Button"><Setter Property="Transitions" Value="{x:Null}" /></Style>
  <Style Selector="Window.no-motion Button.card:pointerover, Window.no-motion Button.card:pressed"><Setter Property="RenderTransform" Value="none" /></Style>
  <Style Selector="WrapPanel.filters > :is(Control)"><Setter Property="Margin" Value="0,0,8,8" /></Style>
  <Style Selector="ListBox.navigation ListBoxItem"><Setter Property="Padding" Value="14,12" /><Setter Property="MinHeight" Value="44" /></Style>
  <Style Selector="ComboBox.company-filter"><Setter Property="Width" Value="172" /></Style>
  <Style Selector="ComboBox.short-filter"><Setter Property="Width" Value="116" /></Style>
  <Style Selector="Border.detail-record"><Setter Property="Padding" Value="12" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="StackPanel.detail-field"><Setter Property="Margin" Value="0,0,0,8" /></Style>
  <Style Selector="StackPanel.settings-page"><Setter Property="MaxWidth" Value="{StaticResource FormMaximumWidth}" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Spacing" Value="16" /></Style>
  <Style Selector="Expander.advanced"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" /></Style>
  <Style Selector="Expander.advanced /template/ ToggleButton"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InputEdgeBrush}" /></Style>
  <Style Selector="Expander.advanced > StackPanel"><Setter Property="Margin" Value="0,12,0,0" /></Style>
  <Style Selector="Button.form-action"><Setter Property="HorizontalAlignment" Value="Left" /></Style>
  <Style Selector="Border.workflow-note"><Setter Property="Padding" Value="12" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Style>
  <Style Selector="TextBox.technical"><Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" /><Setter Property="FontSize" Value="{StaticResource FontCaption}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Button.catalog-card"><Setter Property="Height" Value="420" /></Style>
  <Style Selector="ProgressBar.catalog-progress"><Setter Property="IsIndeterminate" Value="True" /><Setter Property="Height" Value="4" /></Style>
  <Style Selector="Window.no-motion ProgressBar.catalog-progress"><Setter Property="IsIndeterminate" Value="False" /><Setter Property="Value" Value="50" /></Style>
  <Style Selector="TextBox.short-filter"><Setter Property="Width" Value="150" /></Style>
</Styles>
