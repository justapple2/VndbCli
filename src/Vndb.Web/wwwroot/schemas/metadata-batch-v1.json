{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vndb-local:metadata-batch:v1",
  "title": "VN Library metadata batch v1",
  "description": "完整 snapshot 或待补全清单。来源声明不构成认证；路径和命令不执行。活跃大小限制由 /api/v1/info 发现。",
  "type": "object",
  "required": ["format", "format_version", "kind", "items"],
  "properties": {
    "format": { "const": "vn-library-batch" },
    "format_version": { "const": 1 },
    "kind": { "const": "metadata" },
    "batch_id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$" },
    "exported_at": { "type": "string", "format": "date-time" },
    "items": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "producer": {
      "type": "object", "required": ["id", "name"],
      "properties": { "id": { "type": "string", "pattern": "^p[1-9][0-9]*$" }, "name": { "type": "string", "minLength": 1 }, "original": { "type": ["string", "null"] } }
    },
    "novel": {
      "type": "object", "required": ["id", "title", "developers", "titles", "aliases", "languages", "platforms", "description", "image", "released", "alttitle", "olang", "rating", "votecount", "length_minutes"],
      "properties": {
        "id": { "type": "string", "pattern": "^v[1-9][0-9]*$" }, "title": { "type": "string", "minLength": 1 },
        "developers": { "type": "array", "items": { "$ref": "#/$defs/producer" } },
        "titles": { "type": "array" }, "aliases": { "type": "array", "items": { "type": "string" } },
        "languages": { "type": "array", "items": { "type": "string" } }, "platforms": { "type": "array", "items": { "type": "string" } },
        "description": { "type": ["string", "null"] },
        "release_catalog": {
          "description": "可选完整发行目录；缺失表示尚未查询。",
          "type": ["object", "null"], "required": ["items", "fetched_at"],
          "properties": {
            "fetched_at": { "type": "string", "format": "date-time" },
            "items": { "type": "array", "maxItems": 1000, "items": {
              "type": "object", "required": ["id", "title", "languages", "platforms", "vns", "producers"],
              "properties": { "id": { "type": "string", "pattern": "^r[1-9][0-9]*$" } }
            } }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "anyOf": [ { "required": ["vndb_id"] }, { "required": ["title"] } ],
      "properties": {
        "vndb_id": { "type": "string", "pattern": "^[vp][1-9][0-9]*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "kind": { "enum": ["vn", "producer"] },
        "novel": { "oneOf": [ { "$ref": "#/$defs/novel" }, { "type": "null" } ] },
        "producer": { "oneOf": [ { "$ref": "#/$defs/producer" }, { "type": "null" } ] },
        "developers": { "type": "array", "items": { "$ref": "#/$defs/producer" } },
        "fetched_at": { "type": "string", "format": "date-time" },
        "provenance": { "type": "string" }, "completeness": { "enum": ["full_text", "partial_text"] },
        "cover": { "type": "object" }
      },
      "dependentRequired": { "novel": ["kind", "fetched_at"], "producer": ["kind", "fetched_at"] }
    }
  }
}
